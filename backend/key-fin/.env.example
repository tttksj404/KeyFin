# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. .env는 커밋 금지(.gitignore 처리됨)
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRATION=30m
JWT_REFRESH_EXPIRATION=336h

# CORS — 브라우저 프론트엔드의 허용 Origin (쉼표 구분, 포트 와일드카드 [*] 사용 가능)
# 미설정 시 localhost 전 포트와 배포 도메인이 기본 허용된다.
CORS_ALLOWED_ORIGINS=http://localhost:[*],https://j15a408.p.ssafy.io

FINANCE_API_BASE_URL=https://finance.example.com/finance/api/v1
FINANCE_API_KEY=금융망-api-key
FINANCE_API_CONNECT_TIMEOUT=3s
FINANCE_API_READ_TIMEOUT=5s
FINANCE_API_MAX_ATTEMPTS=3
FINANCE_API_RETRY_BASE_DELAY=100ms
FINANCE_API_RETRY_MAX_DELAY=1s
FINANCE_API_RETRY_TIME_LIMIT=8s

# FCM — 서버에서 실제 발송 기능을 사용할 때 true. 기기 등록 API만 확인할 때는 false.
# 활성화하면 Firebase 인증 실패 시 서버 시작도 실패한다.
FCM_ENABLED=false
# Firebase Admin 서비스 계정 JSON은 저장소 밖에 보관하고 실제 절대 경로를 지정한다.
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/SSAFY/secrets/keyfin-firebase-admin.json
# IntelliJ: Run > Edit Configurations > Environment variables에서 이 .env를 연결한다.
# .env를 작성하는 것만으로 Java 프로세스의 환경변수가 설정되지는 않는다.

# 기기 등록 API는 FCM_ENABLED=false여도 사용 가능하다.
# DB 기반 수동 발송: FcmDatabaseManualTest JUnit 구성에만 아래 두 변수를 추가한다.
# FCM_MANUAL_TEST=true
# FCM_TEST_USER_ID=1
# 수동 테스트는 자체적으로 Firebase를 활성화하므로 공용 FCM_ENABLED는 false로 유지해도 된다.
# 위 테스트는 DB_URL/DB_USERNAME/DB_PASSWORD와 GOOGLE_APPLICATION_CREDENTIALS를 사용한다.
# 일반 자동 테스트나 서버 Run Configuration에는 FCM_MANUAL_TEST를 설정하지 않는다.
