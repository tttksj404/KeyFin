// MR validation job: use a regular Pipeline job with the Jenkins GitLab plugin.
// Pipeline script from SCM: this repository, branch */develop, Script Path Jenkinsfile.mr.
// Commit this file to that branch before enabling the job. SCM credentials are reused below.
// Select the GitLab connection (with an API token) in the job configuration.
// Configure the trigger in the UI so its webhook secret stays out of source control:
//   - Created Merge Request Events: enabled; Rebuild open Merge Requests: On push to source branch.
//   - Push Events, Accepted/Closed Merge Request Events, and Pipeline Events: disabled.
//   - Branch filter: RegexBasedFilter; source: .*; target: ^develop$.
//   - Pending build name for pipeline: backend-mr-ci; CI skip: disabled.
// Keep this status name for compatibility; it now covers both frontend and backend checks.
// The GitLab webhook for this job must send both Merge request events and Push events.
// In GitLab, enable Pipelines must succeed and leave skipped pipelines unsuccessful.

def reportMrStatus = false

// Compare against a known successful/develop base, not Jenkins' previous job-wide changelog.
def selectCiComponents(String baseCommit) {
    def allComponents = [backend: true, frontend: true]
    if (!(baseCommit ==~ /[0-9a-fA-F]{40}/)) {
        echo 'No comparison baseline is available; validating both applications.'
        return allComponents
    }

    return withEnv(["CI_DIFF_BASE=${baseCommit}"]) {
        if (sh(script: 'git merge-base --is-ancestor "$CI_DIFF_BASE" HEAD',
               returnStatus: true) != 0) {
            echo 'The baseline is unavailable or not an ancestor; validating both applications.'
            return allComponents
        }

        // Disable rename detection so moves between applications select both sides.
        def paths = sh(
            script: 'git -c core.quotepath=false diff --no-renames --name-only "$CI_DIFF_BASE" HEAD --',
            returnStdout: true
        ).readLines()
        def sharedChange = paths.any { path ->
            !path.startsWith('backend/') && !path.startsWith('frontend/') &&
            !path.startsWith('ai/') && !path.startsWith('docs/') &&
            !path.startsWith('.gitlab/merge_request_templates/') && path != 'README.md'
        }

        return [
            backend: sharedChange || paths.any { it.startsWith('backend/') },
            frontend: sharedChange || paths.any { it.startsWith('frontend/') }
        ]
    }
}

// Use the agent's existing Docker daemon; Node/pnpm are only needed inside this image.
def checkFrontend() {
    writeFile file: '.ci-frontend.Dockerfile', text: '''
FROM node:24-bookworm-slim
ENV CI=true COREPACK_ENABLE_DOWNLOAD_PROMPT=0 EXPO_NO_TELEMETRY=1
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
ARG CI_RUN_ID
RUN echo "CI run: $CI_RUN_ID" && pnpm run typecheck
RUN pnpm run lint
RUN pnpm test --ci --runInBand
'''
    // Cache dependency installation, but execute the checks again for each Jenkins build.
    sh 'docker build --build-arg "CI_RUN_ID=$BUILD_TAG" --file .ci-frontend.Dockerfile frontend'
}

pipeline {
    agent { label 'backend-ci' }

    environment {
        // The workspace is wiped every build; keep Gradle's dependency and build caches on the persistent agent volume.
        GRADLE_USER_HOME = '/home/jenkins/agent/.gradle'
    }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        skipStagesAfterUnstable()
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Validate MR Event') {
            steps {
                script {
                    if (!(env.gitlabMergeRequestIid ==~ /[1-9][0-9]*/) ||
                        !env.gitlabSourceBranch ||
                        !(env.gitlabMergeRequestLastCommit ==~ /[0-9a-fA-F]{40}/)) {
                        error('This job requires a GitLab MR event. Trigger it by opening or updating an MR.')
                    }

                    if (env.gitlabTargetBranch != 'develop') {
                        error('This job only validates merge requests targeting develop.')
                    }

                    if (env.gitlabMergeRequestState &&
                        !(env.gitlabMergeRequestState in ['opened', 'reopened'])) {
                        error('This job only validates open merge requests.')
                    }

                    reportMrStatus = true
                    // The GitLab plugin reports against the source commit in the webhook cause.
                    updateGitlabCommitStatus name: 'backend-mr-ci', state: 'running'
                }
            }
        }

        stage('Checkout MR Commit') {
            steps {
                deleteDir()

                script {
                    if (scm.userRemoteConfigs.size() != 1) {
                        error('Configure exactly one Git remote for this Pipeline job.')
                    }

                    def remote = scm.userRemoteConfigs[0]
                    def mrRef = "refs/merge-requests/${env.gitlabMergeRequestIid}/head"

                    // Fetch the MR ref from the configured repository and pin the webhook SHA.
                    // A newer push must never make an older build test a different commit.
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: env.gitlabMergeRequestLastCommit]],
                        extensions: [[$class: 'CloneOption',
                                      shallow: false, noTags: true,
                                      honorRefspec: true, timeout: 10]],
                        userRemoteConfigs: [[
                            name: 'origin',
                            url: remote.url,
                            credentialsId: remote.credentialsId,
                            refspec: "+${mrRef}:refs/remotes/origin/mr-${env.gitlabMergeRequestIid} " +
                                     '+refs/heads/develop:refs/remotes/origin/develop'
                        ]]
                    ])

                    def checkedOutCommit = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true
                    ).trim()

                    if (!checkedOutCommit.equalsIgnoreCase(env.gitlabMergeRequestLastCommit)) {
                        error('The checked-out commit does not match the GitLab MR event.')
                    }
                }

                sh 'git log -1 --format="%H %s"'
            }
        }

        stage('Select Changed Applications') {
            steps {
                script {
                    // Compare the complete MR diff, including changes from earlier MR commits.
                    def baseCommit = sh(
                        script: 'git merge-base HEAD refs/remotes/origin/develop || true',
                        returnStdout: true
                    ).trim()
                    def components = selectCiComponents(baseCommit)
                    env.CI_RUN_BACKEND = components.backend.toString()
                    env.CI_RUN_FRONTEND = components.frontend.toString()
                    echo "Backend: ${env.CI_RUN_BACKEND}; frontend: ${env.CI_RUN_FRONTEND}"
                }
            }
        }

        stage('Backend Environment Check') {
            when { expression { env.CI_RUN_BACKEND == 'true' } }
            steps {
                // Integration tests use Testcontainers, even though this job does not deploy.
                sh '''
                    set -eu
                    echo "Node: $NODE_NAME"
                    java -version
                    javac -version
                    git --version
                    test -S /var/run/docker.sock
                    test -r /var/run/docker.sock
                    test -w /var/run/docker.sock
                '''
            }
        }

        stage('Backend Test') {
            when { expression { env.CI_RUN_BACKEND == 'true' } }
            steps {
                dir('backend/key-fin') {
                    sh 'bash ./gradlew --max-workers=2 --build-cache --console=plain --stacktrace test --rerun'
                }
            }
            post {
                always {
                    junit testResults: 'backend/key-fin/build/test-results/test/*.xml', allowEmptyResults: false
                }
            }
        }

        stage('Frontend Checks') {
            when { expression { env.CI_RUN_FRONTEND == 'true' } }
            steps {
                script { checkFrontend() }
            }
        }

        stage('Package JAR') {
            when { expression { env.CI_RUN_BACKEND == 'true' } }
            steps {
                dir('backend/key-fin') {
                    sh 'bash ./gradlew --max-workers=2 --build-cache --console=plain --stacktrace bootJar'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'backend/key-fin/build/libs/*.jar',
                                     fingerprint: true
                }
            }
        }
    }

    post {
        always {
            script {
                if (reportMrStatus) {
                    // One status covers all stages, so passing tests alone cannot permit a merge.
                    // JUnit UNSTABLE is a failure for the merge gate; aborts remain non-successful.
                    def states = [SUCCESS: 'success', FAILURE: 'failed',
                                  UNSTABLE: 'failed', ABORTED: 'canceled']
                    updateGitlabCommitStatus name: 'backend-mr-ci',
                                             state: states[currentBuild.currentResult] ?: 'failed'
                }
            }
        }
    }
}
